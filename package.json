{
  "name": "dsh-meme-copy-own",
  "version": "0.1.1",
  "description": "给已安装 dsh-meme 的 DSH 聊天加一个「复制图片」按钮（配套插件，需配合 dsh-meme 使用）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-meme",
    "clipboard"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "tests",
    "locale",
    "icon.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtcjwm/dsh-meme-copy-own.git"
  },
  "homepage": "https://github.com/jtcjwm/dsh-meme-copy-own#readme",
  "bugs": {
    "url": "https://github.com/jtcjwm/dsh-meme-copy-own/issues"
  },
  "author": "jtcjwm",
  "engines": {
    "node": ">=22.13.0"
  },
  "dshCompanion": {
    "name": "dsh-meme",
    "required": true,
    "note": "本插件只包装 dsh-meme 注入的 img[data-meme-img] 与 .mp-cell，没有它不产生可见效果"
  }
}
